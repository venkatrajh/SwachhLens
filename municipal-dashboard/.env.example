# ============================================================
# SWACHHLENS FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================

# Backend API Gateway Endpoint (Canonical: VITE_API_BASE_URL, with VITE_API_URL legacy fallback)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth 2.0 Client ID (Required ONLY if Google Sign-In is enabled)
# Generate from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client ID
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
