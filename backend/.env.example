# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="SwachhLens API"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development          # development | staging | production

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# SQLAlchemy async-compatible connection string using psycopg (psycopg3).
# Supabase Session Pooler format (port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (port 5432, no pooler):
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/swachlens

# ── JWT (Phase 3) ─────────────────────────────────────────────────────────────
# REQUIRED in production — must be a long, cryptographically random secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email verification (Phase 3) ─────────────────────────────────────────────
# Hours before a verification token expires (default: 24)
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ── Password reset (Phase 3) ─────────────────────────────────────────────────
# Minutes before a password-reset token expires (default: 30)
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Brevo / Transactional email (Phase 3) ────────────────────────────────────
# Obtain your API key from https://app.brevo.com → SMTP & API → API Keys
# NEVER commit this value — it is a secret.
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=<your sender email>
BREVO_SENDER_NAME=SwachhLens

# ── Frontend base URL (for email links) ──────────────────────────────────────
# Used to build verification / password-reset links in emails.
FRONTEND_BASE_URL=http://localhost:3000

# ── AI / Vision (Phase 5: Groq) ──────────────────────────────────────────────
GROQ_API_KEY=gsk-...
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT=30
